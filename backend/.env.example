# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
JWT_SECRET=greengate_secret_jwt_key_2026_super_secure

# MYSQL DATABASE CONFIGURATION
# Set USE_MYSQL=true when MySQL database credentials are configured
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=greengate_db

# ALTERNATIVE MYSQL CONNECTION STRING
# DATABASE_URL=mysql://root:password@localhost:3306/greengate_db

# FILE & PHOTO STORAGE CONFIGURATION
UPLOAD_DIR=uploads/visitor-photos
MAX_FILE_SIZE_MB=5

# DLT-APPROVED SMS GATEWAY CONFIGURATION (TRAI COMPLIANT)
# Supported providers: fast2sms | msg91 | textlocal | custom
SMS_GATEWAY_PROVIDER=fast2sms
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=NXGATE
DLT_ENTITY_ID=your_19_digit_principal_entity_id_here
DLT_TEMPLATE_ID=your_dlt_content_template_id_here
# SMS_GATEWAY_URL=https://your-custom-gateway.com/api/send?mobile={MOBILE}&otp={OTP}&sender={SENDER_ID}
SMS_MESSAGE_TEMPLATE=Your OTP for NexGate login is {OTP}. Valid for 10 minutes. Please do not share this OTP with anyone. - NexBuild Technologies
ALLOW_DEV_FIXED_OTP=false
